#!/usr/bin/env sh
strict_env

export NIX_CONFIG="extra-experimental-features = flakes nix-command"

use flake

RUST_VERSION="$(grep 'channel' ./rust-toolchain.toml | grep -o '[0-9]\+\.[0-9]\+' || echo 'stable')"
rustup show active-toolchain >/dev/null || rustup toolchain install "$RUST_VERSION"

PATH_add ./target/debug
